{
  "expo": {
    "name": "Public Pressure",
    "slug": "public-pressure",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "publicpressure",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F2EF",
    "splash": { "backgroundColor": "#141414", "resizeMode": "contain" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.publicpressure.app" },
    "android": {
      "package": "com.publicpressure.app",
      "adaptiveIcon": { "backgroundColor": "#141414" }
    },
    "extra": {
      "apiBase": "http://localhost:4000",
      "note": "On a physical device set apiBase to your machine's LAN IP, e.g. http://192.168.1.20:4000"
    }
  }
}
